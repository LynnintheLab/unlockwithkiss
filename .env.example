# Set these privately in Hostinger's Environment Variables. Never commit real values.
APP_URL=https://your-domain.com
ADMIN_PASSWORD=replace-with-a-long-unique-admin-password
GUEST_PASSWORD=replace-with-your-chosen-guest-password
DRIVE_URL=https://drive.google.com/drive/folders/your-folder-id
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_hostinger_database_user
DB_PASSWORD=your_hostinger_database_password
DB_NAME=your_hostinger_database_name
